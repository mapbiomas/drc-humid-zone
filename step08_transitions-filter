// TRANSITION FILTER

// This filter removes small spatial patches associated with spurious A-B-A temporal transitions.
// It identifies patches up to the defined area threshold and replaces the intermediate year with the previous valid class.

// Define the name of the country 
var country_name = 'DRC';

// Define the name of the region 
var region_name = 'Humid'; 

// Define the version of the previous filter 
var gap_version_in = '2'; 

// Define the output transition filter version.
var transition_version_out = '2';

// Set the year used only for map visualization.
var visYear = '2004';

// Define the years to be processed.
var years = [
  2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008,
  2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017,
  2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025
];
// Input and output collections
var inputCollectionPath = 'projects/mapbiomas-drc/assets/LAND-COVER/COLLECTION-1/GENERAL/classification-ft_2ndWS';
var outputCollectionPath = 'projects/mapbiomas-drc/assets/LAND-COVER/COLLECTION-1/GENERAL/classification-ft_2ndWS';

// Set the maximum transition patch size in pixels.
// Six 30 m pixels correspond to approximately 0.54 ha.
var maxPatchPixels = 6;

// Set the maximum connected-pixel search size.
var connectedPixelMaxSize = 30;

// Set transition patch connectivity.
// true allows diagonal connections; false allows only edge connections.
var useDiagonalConnectivity = false;

// Set the aggregated group value for anthropic or non-vegetated classes.
var anthropicGroup = 1;

// Set the aggregated group value for native vegetation classes.
var nativeGroup = 2;

// Set the aggregated group value for water or glacier classes.
var otherGroup = 7;

// Set native vegetation class IDs.
// 3 = Forest Formation, 4 = Woodland, 5 = Mangrove, 66 = Shrubland
var nativeClasses = [3, 4, 5, 66]; 

// Set anthropic or non-vegetated class IDs.
// 21 = Pasture and Agriculture, 9 = Forest plantation, 24 = Urban area, 25 = Other non vegetated area
var anthropicClasses = [21, 9, 24, 25]; 

// Set water or other class IDs.
// 33 = River or lake, 34 = Glaciers
var otherClasses = [33, 34];

// Define visualization parameters
var palettes = require('users/mapbiomas/modules:Palettes.js');

var vis = {
  'min': 0,
  'max': 69,
  'palette': palettes.get('classification9'),
  'bands': 'classification_' + visYear,
};

// Create the standard classification band name for each year.
var getBandName = function(year) {
  return 'classification_' + year;
};

// Create the standard gap-filled input image name.
var getInputImageName = function(country, region, gapVersion) {
  return country + '_classification_' + region + '_gapfill_v' + gapVersion;
};

// Create the standard transition-filtered output image name.
var getOutputImageName = function(country, region, gapVersion, transitionVersion) {
  return country + '_classification_' + region + '_gapfill_transition_v' + transitionVersion;
};

// Repeat a value in a client-side list.
var repeatValue = function(value, length) {
  var list = [];

  // Add the same value once for each item in the target list.
  for (var i = 0; i < length; i++) {
    list.push(value);
  }

  // Return the repeated-value list.
  return list;
};

// Create the expected list of annual classification band names.
var bandNames = years.map(function(year) {
  return getBandName(year);
});

// Create the full gap-filled input image name.
var inputImageName = getInputImageName(country_name, region_name, gap_version_in);

// Create the full output image name.
var outputImageName = getOutputImageName(country_name, region_name, gap_version_in, transition_version_out);

// Load the gap-filled multiband classification image.
var classificationInput = ee.Image(inputCollectionPath + '/' + inputImageName).select(bandNames);

// Print the input classification image for inspection.
print('Input classification', classificationInput);

// Print the patch-size threshold for inspection.
print('Maximum patch size in pixels', maxPatchPixels);

// Display the input classification for the selected visualization year.
Map.addLayer(classificationInput.select(getBandName(visYear)), vis, 'Before transition filter - ' + region_name + ' - ' + visYear, false);

// Combine the original class IDs used in the aggregation.
var originalClasses = nativeClasses.concat(anthropicClasses).concat(otherClasses);

// Create the corresponding aggregated group values.
var aggregatedClasses = repeatValue(nativeGroup, nativeClasses.length)
  .concat(repeatValue(anthropicGroup, anthropicClasses.length))
  .concat(repeatValue(otherGroup, otherClasses.length));

// Aggregate detailed classes into broad groups used to identify temporal transitions.
var aggregateClasses = function(image, outputName) {
  // Remap detailed class IDs into broader transition groups.
  var grouped = image.remap(originalClasses, aggregatedClasses, 0);

  // Rename and convert the grouped image to byte.
  return grouped.rename(outputName).byte();
};

// Apply the spatial-temporal transition filter to one year.
var applyTransitionFilter = function(year) {
  // Create the band name for the current year.
  var bandName = getBandName(year);

  // Select the current year classification.
  var current = classificationInput.select(bandName);

  // Keep the first and last years unchanged because they do not have a complete 3-year window.
  if (year === years[0] || year === years[years.length - 1]) {
    return current.rename(bandName).byte();
  }

  // Select the previous year classification.
  var previous = classificationInput.select(getBandName(year - 1));

  // Select the next year classification.
  var next = classificationInput.select(getBandName(year + 1));

  // Aggregate the previous year into broad transition groups.
  var previousGroup = aggregateClasses(previous, 'previous_group');

  // Aggregate the current year into broad transition groups.
  var currentGroup = aggregateClasses(current, 'current_group');

  // Aggregate the next year into broad transition groups.
  var nextGroup = aggregateClasses(next, 'next_group');

  // Identify pixels with valid grouped classes in the full 3-year window.
  var validWindow = previousGroup.gt(0).and(currentGroup.gt(0)).and(nextGroup.gt(0));

  // Identify A-B-A temporal transitions where the previous and next years are equal and the current year is different.
  var spuriousTransition = previousGroup.eq(nextGroup).and(currentGroup.neq(previousGroup)).and(validWindow);

  // Encode each grouped transition type as a numeric transition code.
  var transitionCode = previousGroup.multiply(100).add(currentGroup.multiply(10)).add(nextGroup).rename('transition_code').toInt16();

  // Count connected pixels within each spurious transition type.
  var transitionPatchSize = transitionCode.updateMask(spuriousTransition).connectedPixelCount(connectedPixelMaxSize, useDiagonalConnectivity);

  // Identify spurious transition patches equal to or smaller than six connected pixels.
  var smallTransitionPatch = transitionPatchSize.lte(maxPatchPixels);

  // Identify pixels that are both temporally inconsistent and spatially small.
  var correctionMask = spuriousTransition.and(smallTransitionPatch);

  // Replace the intermediate year with the previous year's original class only inside small transition patches.
  var corrected = current.where(correctionMask, previous).rename(bandName).byte();

  // Return the corrected annual classification band.
  return corrected;
};

// Apply the transition filter to all years in the temporal series.
var correctedYears = years.map(function(year) {
  return applyTransitionFilter(year);
});

// Convert the annual corrected images into a single multiband image.
var transitionFiltered = ee.ImageCollection.fromImages(correctedYears).toBands().rename(bandNames).byte();

// Store metadata in the transition-filtered image.
transitionFiltered = transitionFiltered
  .set('country', country_name)
  .set('region', region_name)
  .set('version', transition_version_out)
  .set('gapfill_version', gap_version_in)
  .set('filter', 'transitions')
  .set('max_patch_pixels', maxPatchPixels)
  .set('input_collection', inputCollectionPath)
  .set('input_asset', inputImageName)
  .set('output_collection', outputCollectionPath);

// Print the output classification image for inspection.
print('Output classification', transitionFiltered);

// Print the output band names for inspection.
print('Output bands', transitionFiltered.bandNames());

// Display the transition-filtered classification for the selected visualization year.
Map.addLayer(transitionFiltered.select(getBandName(visYear)), vis, 'After transition filter - ' + region_name + ' - ' + visYear, true);

// Create the full output asset ID inside the output ImageCollection.
var outputAssetId = outputCollectionPath + '/' + outputImageName;

// Export one multiband transition-filtered image for the selected region.
Export.image.toAsset({
  image: transitionFiltered,
  description: outputImageName,
  assetId: outputAssetId,
  pyramidingPolicy: { '.default': 'mode' },
  region: classificationInput.geometry(),
  scale: 30,
  maxPixels: 1e13
});

// Import the DRC classification regions 
var region_training = ee.FeatureCollection('projects/mapbiomas-drc/assets/LAND-COVER/COLLECTION-1/GENERAL/SAMPLES/drc_regions_training');

// Filter only the region of interest 
var region_limit = region_training.filter(ee.Filter.eq('name', region_name));
Map.addLayer(region_limit, {}, 'Region', false);  // Add region to the map 
