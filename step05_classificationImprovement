// STABLE SAMPLE CLASSIFICATION AND COMPLEMENTARY SAMPLE COLLECTION

// This script uses stable training samples generated in the previous step,
// combines them with auxiliary samples collected from manually drawn polygons,
// and trains annual Random Forest classifiers. The resulting yearly
// classifications are displayed on the map and exported as Google Earth Engine
// assets. A sampling grid is also generated to support visual inspection and 
// additional auxiliary sample collection.

// Define the name of the country 
var country_name = 'DRC';

// Define the classification region name
var region_name = 'Humid';

// Define the input version of the stable sample collection - generated in step04
var stable_samples_version_in = '11';   

// Define the output version of the classification
var classification_version_out = '11'; 

// Define the years to be processed
var years = [
  2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008,
  2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017,
  2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025
];
           
// Define the number of trees used in the Random Forest classifier
var ntree = 100;

// Define the grid cell size in meters for visual inspection
var gridSize = 100000; 

// Define the predictor bands to be used in the classification.
//
// This list is currently not used directly because the classifier uses
// Landsat_annual_mosaic.bandNames() as inputProperties.
/*
var bands = [
  'red_median', 'green_median', 'blue_median',
  'nir_median', 'swir1_median', 'swir2_median',
  'evi2_median_dry', 'evi2_median_wet', 'evi2_stdDev',
  'ndvi_median_dry', 'ndvi_median_wet', 'ndvi_stdDev',
  'ndwi_median_dry', 'ndwi_median_wet', 'ndwi_stdDev',
  'slope'
];
*/

// Define a function to convert manually drawn polygons into random sample points
var generatePoints = function(classValue, polygons, nPoints) {
  
  // Convert the input geometry or geometry collection into a FeatureCollection
  polygons = ee.FeatureCollection(polygons);

  // Check whether the polygon collection is empty
  var isEmpty = polygons.size().eq(0);

  // Generate random points inside the polygons and assign the class value
  var points = ee.FeatureCollection(
    ee.Algorithms.If(
      isEmpty,
      ee.FeatureCollection([]),  // return empty FC if class is empty
      ee.FeatureCollection.randomPoints({
        region: polygons.geometry(),
        points: nPoints,
        maxError: 1
      }).map(function(pt) {
        return pt.set('class', classValue);
      })
    )
  );

  return points;
};

// Initialize an empty collection to store the auxiliary samples
var Complementary_samples = ee.FeatureCollection([]);

// Generate and merge auxiliary samples from manually drawn polygons.
// Each line follows the structure:
// generatePoints(class_id, polygon_collection, number_of_samples)
Complementary_samples = Complementary_samples
  .merge(generatePoints( 3, Forest, 500))
  .merge(generatePoints( 4, Woodland, 500))
  .merge(generatePoints( 5, Mangrove, 500))
  .merge(generatePoints( 66, Shrubland, 500))
  .merge(generatePoints( 21, PastureAgriculture, 500))
  .merge(generatePoints( 9, ForestPlantation, 500))
  .merge(generatePoints( 24, Urban, 500))
  .merge(generatePoints( 25, OtherNonVegetated, 500))
  .merge(generatePoints( 33, Water, 500))
  .merge(generatePoints( 34, Glacier, 500));

// Print the number of auxiliary samples per class
print('Complementary_samples per class',
      Complementary_samples.aggregate_histogram('class'));

// Define the folder where the stable samples are stored
var sample_folder = 'projects/mapbiomas-drc/assets/LAND-COVER/COLLECTION-1/GENERAL/SAMPLES/';

// Define the input stable sample collection name
var stable_samples_name_in = 'filteredSamples_spectralLib_2ndWS_';

// Define the folder where the classifications will be exported 
var class_folder = 'projects/mapbiomas-drc/assets/LAND-COVER/COLLECTION-1/GENERAL/classification_2ndWS/';

// Define the output classification name
var classification_name_out = 'classification';

// Read the DRC classification regions.
var region_training = ee.FeatureCollection(
  'projects/mapbiomas-drc/assets/LAND-COVER/COLLECTION-1/GENERAL/SAMPLES/drc_regions_training'
);

// Filter the classification regions to select only the region of interest.
var region_limit = region_training
  .filter(ee.Filter.eq('name', region_name));

// Load the Landsat mosaic collection for the DRC
var Land_collection = ee.ImageCollection('projects/nexgenmap/MapBiomas2/LANDSAT/DRC/mosaics-2');

// Define visualization parameters for the Landsat mosaics
var visLandsat = {"bands": ["swir1_median", "nir_median", "red_median"],"min": 0, "max": 5615, "gamma":1};

// Initialize the Random Forest classifier
var classifier = ee.Classifier.smileRandomForest({
    'numberOfTrees': ntree
});

// Load the MapBiomas palette module for visualization.
var palettes = require('users/mapbiomas/modules:Palettes.js');

// Define visualization parameters for the land use and land cover classification
var visLULC = {'min': 0,'max': 69,'palette': palettes.get('classification9')};

// Create an empty image to store recipe information if needed in later steps
var recipe = ee.Image([]);

// Loop through each year to train, apply, and export the annual classifier
years.forEach(function(year) {

    // Read and clip the Landsat mosaic for the current year
    var Landsat_annual_mosaic = Land_collection.filter(ee.Filter.eq('year', year)).mosaic().clip(region_limit);
    
    // Extract spectral information from the auxiliary sample points
    var trainedComplementary_samples = Landsat_annual_mosaic.reduceRegions({
        'collection': Complementary_samples, 
        'reducer': ee.Reducer.first(), 
        'scale': 30,
      });
    
    // Remove auxiliary samples with missing spectral values.
    trainedComplementary_samples = trainedComplementary_samples
      .filter(ee.Filter.notNull(['red_median']));
    
     // Read the stable training samples for the current year
    var StabletrainedSamples = ee.FeatureCollection(sample_folder + stable_samples_name_in + region_name + '_' + year + '_v' + stable_samples_version_in);

    // Merge stable samples with complementary samples
    var totalTrainedSamples = StabletrainedSamples.merge(trainedComplementary_samples);
  
    // Train the Random Forest classifier using the combined training samples
    classifier = classifier.train({
      'features': totalTrainedSamples, 
      'classProperty': 'class', 
      'inputProperties': Landsat_annual_mosaic.bandNames()
      }
    );
  
  // Print variable importance if model inspection is needed.
  // print('Variable importance [' + year + ']', classifier.explain());
  
  // Apply the trained Random Forest classifier to the annual Landsat mosaic
  var classification = Landsat_annual_mosaic.classify(classifier);
  
  // Display the Landsat mosaic for the current year.
  Map.addLayer(Land_collection.filter(ee.Filter.eq('year', year)).filterBounds(region_limit).mosaic().clip(region_limit), visLandsat, 'Landsat ' + year, false);
  
  // Display the annual classification.
  Map.addLayer(classification, visLULC,'LULC RF classification ' + year, true);
  
  // Add metadata to the annual classification image.
  classification = classification.set({'version': classification_version_out})
                                 .set({'year': year})
                                 .set({'region': region_name});
  
  // Define the annual output classification name
  var class_name = country_name + '_' + classification_name_out + '_' + region_name + '_' + year + '_v' + classification_version_out ;
  print(class_name);
  
  // Export the annual classification as a Google Earth Engine asset
  Export.image.toAsset({
      "image": classification.rename('classification_' + year),
      "description": class_name,
      "assetId": class_folder + class_name,
      "scale": 30,
      "pyramidingPolicy": {
          '.default': 'mode'
      },
      "maxPixels": 1e13,
      "region": region_limit
  }); 

});


// Define the grid cell size in meters.
var proj = ee.Projection('EPSG:4326').atScale(gridSize);
var grid = region_limit.geometry().coveringGrid(proj, gridSize); 
Map.addLayer(ee.Image().paint(grid, 0.5, 0.7), {palette: ['brown']}, 'Sampling Grid');
